<Window x:Class="PhoneSyncDataReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone Sync Data Reader" Icon="Assets/PhoneSyncDataReader.ico" Height="860" Width="1480" MinHeight="700" MinWidth="1100"
        Background="#F2F5F3" Foreground="{StaticResource InkBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#173F35" Padding="22,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Phone Sync Data Reader" Foreground="White" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="Indexed archive browser for recovered files, JSON records, messages, and media" Foreground="#CFE3DC" FontSize="13" />
                </StackPanel>
                <TextBlock x:Name="StatsText" DockPanel.Dock="Right" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="ChooseFolderButton" Content="Choose archive folder" Click="ChooseFolder_Click" />
                <TextBlock Grid.Column="1" x:Name="ArchivePathText" Text="No archive selected" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,16,0" />
                <Button Grid.Column="2" x:Name="RebuildButton" Content="Build local index" Click="Rebuild_Click" IsEnabled="False" />
                <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="Open index folder" Click="OpenIndexFolder_Click" IsEnabled="False" x:Name="OpenIndexFolderButton" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="200" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2.2*" MinWidth="420" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="1.7*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14">
                <StackPanel>
                    <TextBlock Text="Query" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="Source folder" FontWeight="SemiBold" />
                    <ComboBox x:Name="SourceFilter" Margin="0,5,0,12" SelectionChanged="Filter_Changed" DisplayMemberPath="Label" />
                    <TextBlock Text="Focus" FontWeight="SemiBold" />
                    <ComboBox x:Name="FocusFilter" Margin="0,5,0,12" SelectionChanged="Filter_Changed" DisplayMemberPath="Label" />
                    <TextBlock Text="Data type" FontWeight="SemiBold" />
                    <ComboBox x:Name="KindFilter" Margin="0,5,0,12" SelectionChanged="Filter_Changed" DisplayMemberPath="Label" />
                    <TextBlock Text="Search records and fields" FontWeight="SemiBold" />
                    <TextBox x:Name="SearchText" Margin="0,5,0,8" KeyDown="SearchText_KeyDown" />
                    <Button Content="Search database" Click="Search_Click" Margin="0,0,0,12" />
                    <CheckBox x:Name="SelectedOnlyCheckBox" Content="Show selected only" Checked="SelectedOnly_Changed" Unchecked="SelectedOnly_Changed" Margin="0,0,0,8" />
                    <WrapPanel Margin="0,0,0,12">
                        <Button Style="{StaticResource SecondaryButton}" Content="Select shown" Click="SelectShown_Click" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Clear" Click="ClearSelection_Click" />
                    </WrapPanel>
                    <TextBlock Text="Folder labels" FontWeight="SemiBold" />
                    <TextBlock Text="Source, collection, and record labels are derived from archive folders and ZIP entry folders." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                    <TextBlock Text="Idempotency" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <TextBlock Text="Files deduplicate by SHA-256; records deduplicate by canonical field hash within each labeled collection." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#D9DFDC" />

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="14,12">
                        <TextBlock Text="Records" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <TextBlock x:Name="ResultCountText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" />
                    </DockPanel>
                    <DataGrid Grid.Row="1" x:Name="RecordsGrid" AutoGenerateColumns="False" IsReadOnly="False"
                              SelectionMode="Single" SelectionChanged="RecordsGrid_SelectionChanged"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                              RowHeaderWidth="0" AlternatingRowBackground="#F6F9F7">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Pick" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="RecordSelection_Click" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="145" IsReadOnly="True" />
                            <DataGridTextColumn Header="Collection" Binding="{Binding CollectionLabel}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="Title / sender" Binding="{Binding Title}" Width="170" IsReadOnly="True" />
                            <DataGridTextColumn Header="Message / summary" Binding="{Binding Summary}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="#D9DFDC" />

            <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="220" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="DetailTitle" Text="Select a record" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" x:Name="DetailMetadata" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    <TextBlock Grid.Row="2" x:Name="DetailSummary" TextWrapping="Wrap" FontSize="15" Margin="0,12,0,10" />
                    <Button Grid.Row="3" x:Name="OpenMediaButton" Content="Open media" Click="OpenMedia_Click" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,10" />
                    <Border Grid.Row="4" x:Name="PreviewBorder" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="#EEF2F0" Visibility="Collapsed">
                        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="6" />
                    </Border>
                    <DataGrid Grid.Row="5" x:Name="FieldsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" BorderThickness="0" Margin="0,10,0,0" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Field path" Binding="{Binding Path}" Width="180" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText" Text="Choose an archived recovery folder to begin." TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1" x:Name="IndexProgress" Height="10" Minimum="0" Maximum="1" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
